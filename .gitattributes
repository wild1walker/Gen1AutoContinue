# The release workflow packs `git archive HEAD`, so anything marked
# export-ignore here stays out of the installable .zip.
#
# tests/ is the important one: the suite requires engine modules
# (tests.modkit, src.mods.Runtime), which would be a private-require finding
# against the packaged archive.  It belongs in the repo and not in the zip.
tests/ export-ignore
.github/ export-ignore
README.md export-ignore
CHANGELOG.md export-ignore
.gitattributes export-ignore
.modkitignore export-ignore
site/ export-ignore
tools/ export-ignore
